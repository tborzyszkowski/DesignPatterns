@startuml flyweight_vs_pool
title Flyweight vs Object Pool vs Cache - porównanie

skinparam monochrome true
skinparam dpi 150

rectangle "Flyweight" {
    note as F1
    Cel: zmniejszenie liczby obiektów
      przez współdzielenie intrinsic state
      ----
      Stan: tylko intrinsic (read-only)
      Życie: cały czas w cache factory
      Dostepp: wielu klientow jednocześnie
      ----
      Przykład: glify czcionki,
      kafelki mapy, ikony UI
    end note
}

rectangle "Object Pool" {
    note as P1
      Cel: ograniczenie kosztu
      tworzenia i niszczenia obiektów
      ----
      Stan: pełny, mutowalny
      Życie: wypożyczony/zwrócony
      Dostęp: tylko jeden klient na raz
      ----
      Przykład: połączenia DB,
      wątki, parsery XML
    end note
}

rectangle "Cache" {
    note as C1
      Cel: pamiętanie wyników
      kosztownych obliczeń / zapytan
      ----
      Stan: wartość wyniku (nie obiekt modelu)
      Życie: do wyganiescia TTL lub ewikscji
      Dostęp: wielu klientow jednocześnie
      ----
      Przykład: kursy walut, tokeny JWT,
      wyniki zapytan HTTP
    end note
}

F1 -[hidden]- P1
P1 -[hidden]- C1

@enduml
