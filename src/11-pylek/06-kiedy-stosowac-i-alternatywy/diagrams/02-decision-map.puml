@startuml flyweight_decision_map
title Flyweight - procedura decyzyjna

skinparam monochrome true
skinparam dpi 150

start

:Masz problem z pamięcią lub GC?;
if (TAK) then (tak)
else (nie)
    :Brak problemu - nie optymalizuj;
    stop
endif

:Obiekty tymczasowe, wypożyczane i zwracane?;
if (TAK) then (tak)
    :Object Pool;
    stop
else (nie)
endif

:Przechowujesz wyniki obliczeń / zapytan?;
if (TAK) then (tak)
    :Prosty cache\n(IMemoryCache / ConcurrentDictionary);
    stop
else (nie)
endif

:Masz tysiące lub miliony podobnych obiektów?;
if (TAK) then (tak)
else (nie)
    :Prosty model - brak potrzeby Flyweight;
    stop
endif

:Spora część stanu jest identyczna\n(intrinsic >= 30% pol, wysoka powtarzalnosc)?;
if (TAK) then (tak)
else (nie)
    :Flyweight nie da istotnego zysku\nRozwaz: struct, Span<T>, pooling;
    stop
endif

:Intrinsic może być niemutowalny\n(readonly po utworzeniu)?;
if (TAK) then (tak)
else (nie)
    :Mutowalny intrinsic to błąd - Flyweight nie zadziala\nRozwaz refactoring lub inny wzorzec;
    stop
endif

:FLYWEIGHT jest odpowiedni;
if (Dostęp wielowatkowy?) then (TAK)
    :Factory + ConcurrentDictionary;
else (NIE)
    if (Cache może rosnac bez ograniczeń?) then (TAK)
        :Factory + WeakReference;
    else (NIE)
        if (Zbior wartości znany z gory?) then (TAK)
            :Statyczna tablica flyweightow;
        else (NIE)
            :Factory + Dictionary<TKey, IFlyweight>;
        endif
    endif
endif

stop
@enduml
