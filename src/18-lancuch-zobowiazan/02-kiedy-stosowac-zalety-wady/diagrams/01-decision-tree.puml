@startuml cor_decision_tree
skinparam backgroundColor #FAFAFA
skinparam titleFontSize 14
skinparam defaultFontSize 12

title Drzewo decyzyjne — kiedy użyć Łańcucha Zobowiązań?

start
:Czy masz złożoną logikę warunkową\ndo obsługi żądania?;
if (Tak) then (tak)
  :Czy chcesz móc dynamicznie\nzmieniać kolejność/skład handlerów?;
  if (Tak) then (tak)
    :Łańcuch Zobowiązań\nto dobry wybór; <<#90EE90>>
  else (nie)
    :Czy kolejność jest zawsze stała\ni handlerów jest mało (<5)?;
    if (Tak) then (tak)
      :Rozważ prostą sekwencję\nmetod lub Template Method; <<#FFD700>>
    else (nie)
      :Łańcuch Zobowiązań\nz ustaloną kolejnością; <<#90EE90>>
    endif
  endif
else (nie)
  :Czy jest wiele obiektów mogących\nobsłużyć i tylko jeden powinien?;
  if (Tak) then (tak)
    :Łańcuch Zobowiązań\n(wariant exclusive); <<#90EE90>>
  else (nie)
    :Możliwe inne wzorce:\nObserwator, Polecenie; <<#FFB6C1>>
  endif
endif
stop

@enduml
