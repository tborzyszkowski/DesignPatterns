@startuml cor_impl_choice
skinparam backgroundColor #FAFAFA
skinparam titleFontSize 14

title Schemat wyboru implementacji CoR

start
:Czy używasz ASP.NET Core?;
if (Tak) then (tak)
  :Użyj wbudowanego\nMiddleware Pipeline\n(app.Use / IMiddleware); <<#90EE90>>
  stop
else (nie)
endif

:Czy używasz MediatR / CQRS?;
if (Tak) then (tak)
  :Użyj IPipelineBehavior<TReq,TRes>; <<#90EE90>>
  stop
else (nie)
endif

:Czy potrzebujesz testować\npośrednie ogniwa izolowane?;
if (Tak) then (tak)
  :Użyj klasycznego OOP\n(interface + BaseHandler); <<#90EE90>>
else (nie)
  :Czy handlery są proste\ni jednorazowe (lambda)?;
  if (Tak) then (tak)
    :Delegatowy pipeline\n(Func<> / Action<>); <<#FFD700>>
  else (nie)
    :Klasyczny OOP\n(bezpieczniejszy długoterminowo); <<#90EE90>>
  endif
endif

stop
@enduml
