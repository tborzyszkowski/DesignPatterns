@startuml smarthome_sequence
title Smart Home - scenariusz "Wychodzę z domu"

skinparam monochrome true
skinparam dpi 150

actor Użytkownik
participant RemoteContról
participant MacroCommand
participant LightOffCommand
participant SecurityArmCommand
participant ThermostatSetCommand
participant SmartLight
participant SecuritySystem
participant Thermostat

Użytkownik -> RemoteContról : PressButton(slot=0)
activate RemoteContról

RemoteContról -> MacroCommand : Execute()
activate MacroCommand

    MacroCommand -> LightOffCommand : Execute()
    activate LightOffCommand
        LightOffCommand -> SmartLight : TurnOff()
        SmartLight --> LightOffCommand : done
    deactivate LightOffCommand

    MacroCommand -> SecurityArmCommand : Execute()
    activate SecurityArmCommand
        SecurityArmCommand -> SecuritySystem : Arm("1234")
        SecuritySystem --> SecurityArmCommand : done
    deactivate SecurityArmCommand

    MacroCommand -> ThermostatSetCommand : Execute()
    activate ThermostatSetCommand
        ThermostatSetCommand -> Thermostat : SetTemperature(16.0)
        Thermostat --> ThermostatSetCommand : done
    deactivate ThermostatSetCommand

MacroCommand --> RemoteContról : done
deactivate MacroCommand
RemoteContról --> Użytkownik : done
deactivate RemoteContról

note over Użytkownik, Thermostat
  Jeden przycisk = 3 akcje.
  RemoteContról nie wie, ile i jakich.
  MacroCommand jest przezroczysty dla RemoteContról.
end note

== Użytkownik wraca — UNDO ==

Użytkownik -> RemoteContról : PressUndo()
activate RemoteContról
    RemoteContról -> MacroCommand : Undo()
    activate MacroCommand
        note right
          Cofamy w ODWROTNEJ kolejności:
          1. Thermostat → 21°C
          2. SecuritySystem → Disarm
          3. SmartLight → TurnOn
        end note
        MacroCommand -> ThermostatSetCommand : Undo()
        MacroCommand -> SecurityArmCommand : Undo()
        MacroCommand -> LightOffCommand : Undo()
    deactivate MacroCommand
RemoteContról --> Użytkownik : done
deactivate RemoteContról

@enduml
