@startuml strategy_alternatives
skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor #F5F5F5
skinparam titleFontSize 13

title Alternatywy wzorca Strategia

rectangle "Problem:\nWymienne algorytmy" as problem #FFE0B2

rectangle "Strategia\n(interfejs/klasy)" as strategy #A5D6A7
rectangle "Metoda Szablonowa\n(dziedziczenie)" as template #90CAF9
rectangle "Polecenie\n(request jako obiekt)" as command #CE93D8
rectangle "Stan\n(automat skończy)" as state #FFCC80
rectangle "Delegat/Func<>\n(uproszczona)" as func #FFF9C4

problem --> strategy : "wiele wariantów\nkompletnego algorytmu"
problem --> template : "wspólny szkielet\nz krokami"
problem --> command : "historyjka, undo/redo,\nkolejkowanie"
problem --> state : "algorytm zmienia\nsię wewnętrznie"
problem --> func : "algorytm prosty\n(1-3 linie)"

@enduml
