title Problem: eksplozja warunków if/switch

class Navigator #FFCDD2 {
  - _transport : string
  --
  + BuildRoute(from, to) : Route
  --
  if transport == "car" ...
  else if transport == "bike" ...
  else if transport == "walking" ...
  else if transport == "transit" ...
}

