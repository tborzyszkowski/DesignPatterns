@startuml proxy_types
title Cztery typy Proxy - kiedy który stosować

skinparam monochrome true
skinparam dpi 150
skinparam noteFontSize 11

package "Protection Proxy" {
    class ProtectionProxy {
        + Operation()
    }
    note right of ProtectionProxy
      Cel: kontrola uprawnień
      Kiedy: operacje krytyczne (Delete, Write)
      Przykład: sprawdzenie roli przed Delete()
    end note
}

package "Virtual Proxy" {
    class VirtualProxy {
        - _real: RealSubject?
        + Operation()
    }
    note right of VirtualProxy
      Cel: lazy initialization
            Kiedy: ciężki obiekt, może nie być potrzebny
      Przykład: ImageProxy tworzy RealImage
               dopiero przy Display()
    end note
}

package "Remote Proxy" {
    class RemoteProxy {
        + Operation()
    }
    note right of RemoteProxy
      Cel: ukrycie lokalizacji sieciowej
      Kiedy: RealSubject jest na innym hoście
      Przykład: gRPC stub, WCF proxy, HttpClient wrapper
    end note
}

package "Caching Proxy" {
    class CachingProxy {
        - _cache: Dictionary
        + Operation()
    }
    note right of CachingProxy
      Cel: zapamiętanie wyników
      Kiedy: drogie zapytania, wyniki stabilne w czasie
      Przykład: _cache[key] ?? Real.Fetch(key)
    end note
}

@enduml
