@startuml iterator_lazy_sequence
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowColor #6A1B9A
skinparam participantBackgroundColor #EDE7F6
skinparam participantBorderColor #4527A0
skinparam titleFontSize 15

title Lazy Iterator (yield return) — sekwencja wywołań

participant Client
participant "StateMachine\n(generated by compiler)" as SM
note over SM
  Kompilator generuje
  klasę maszyny stanów
  dla metody z yield return
end note

Client -> SM : GetEnumerator()
activate SM
SM --> Client : enumerator (stan=Before)
deactivate SM

Client -> SM : MoveNext()  [1. wywołanie]
activate SM
SM -> SM : wykonaj kod do pierwszego\nyield return
SM --> Client : true, state=1
deactivate SM

Client -> SM : Current
SM --> Client : element1

Client -> SM : MoveNext()  [2. wywołanie]
activate SM
SM -> SM : wznów od miejsca\npo yield return
SM --> Client : true, state=2
deactivate SM

Client -> SM : Current
SM --> Client : element2

Client -> SM : MoveNext()  [3. wywołanie — koniec]
activate SM
SM -> SM : wyjście z metody\nlub yield break
SM --> Client : false
deactivate SM

note right of Client
  Kod metody wykonuje się
  INKREMENTALNIE — tylko tyle
  ile potrzeba dla każdego elementu.
  
  Nieskończone sekwencje są możliwe!
end note

@enduml
