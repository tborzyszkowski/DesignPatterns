@startuml iterator_library_system
skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor #E3F2FD
skinparam classBorderColor #1565C0
skinparam interfaceBackgroundColor #BBDEFB
skinparam interfaceBorderColor #0D47A1
skinparam arrowColor #1565C0
skinparam titleFontSize 15

title Katalog Biblioteki — Diagram klas

interface "IEnumerable<Book>" as IEnum {
  + GetEnumerator() : IEnumerator<Book>
}

interface "ILibraryIterator" as ILibIter {
  Specjalizowany interfejs\nz metadata
  --
  + MoveNext() : bool
  + Current : Book
  + TotalCount : int
}

class Book {
  + Title : string
  + Author : string
  + Genre : string
  + Year : int
  + Available : bool
  + ISBN : string
}

class Library implements IEnum {
  - _books : List<Book>
  + Add(book: Book) : void
  + GetEnumerator() : IEnumerator<Book>
  + GetByAuthor(author: string) : IEnumerable<Book>
  + GetByGenre(genre: string) : IEnumerable<Book>
  + GetAvailable() : IEnumerable<Book>
  + GetByYearRange(from, to) : IEnumerable<Book>
  + GetAlphabetical() : IEnumerable<Book>
  + GetReverse() : IEnumerable<Book>
  + Search(query: string) : IEnumerable<Book>
}

class "LibraryIterator\n(by Author)" as AuthorIter implements ILibIter {
  - _books : IEnumerable<Book>
  - _enumerator : IEnumerator<Book>
  + TotalCount : int
}

class "FilteredIterator<T>" as FilteredIter {
  - _source : IEnumerable<T>
  - _predicate : Func<T,bool>
  + GetEnumerator() : IEnumerator<T>
}

class Client {
  + BrowseCatalog(lib: Library) : void
}

Library --> Book : zawiera
Library ..> AuthorIter : tworzy
Library ..> FilteredIter : tworzy
Client --> Library : używa
Client --> IEnum : iteruje

@enduml
