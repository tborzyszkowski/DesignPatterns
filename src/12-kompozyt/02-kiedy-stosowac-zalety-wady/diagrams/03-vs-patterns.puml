@startuml composite_vs_patterns
title Composite vs alternatywy - kiedy co wybrac

skinparam monochrome true
skinparam dpi 150

rectangle "Composite" {
    note as C
      Problem: jednolite API
      dla hierarchii czesc-calosc
      ----
      Struktura: drzewo (Leaf + Composite)
      Klient: nie rozroznia typow wezlow
      Operacja: delegowana rekurencyjnie
      ----
      Przyklad: system plikow, menu,
      BOM, AST, drzewo sceny GUI
    end note
}

rectangle "Dekorator" {
    note as D
      Problem: rozszerzanie zachowania
      jednego obiektu w locie
      ----
      Struktura: lancuch owinieci
      Klient: widzi jeden obiekt
      Operacja: delegowana do wrappee
      ----
      Przyklad: Stream z kompresja,
      logger z formatowaniem,
      widget ze scrollbarem
    end note
}

rectangle "Visitor" {
    note as V
      Problem: nowe operacje
      na stabilnej strukturze
      ----
      Struktura: drzewo Composite
      + zewnetrzny odwiedzajacy
      Operacja: rozdzielona od struktury
      ----
      Przyklad: eksport XML/PDF,
      analiza statyczna AST,
      raportowanie dokumentow
    end note
}

rectangle "Prosta lista + serwis" {
    note as F
      Problem: brak hierarchii,
      zawsze 1-2 poziomy
      ----
      Struktura: List<T> + klasy domenowe
      Klient: uzywa serwisu domenowego
      Operacja: metoda serwisu
      ----
      Przyklad: lista zamowien,
      produkty w kategorii (1 poziom),
      wiersze w raporcie
    end note
}

C -[hidden]- D
D -[hidden]- V
V -[hidden]- F

@enduml
