@startuml composite_alternatives
title Composite - alternatywy i kiedy co wybrać

skinparam monochrome true
skinparam dpi 150

rectangle "Composite\n(ten wzorzec)" {
    note as C
      Cel: jednolite API dla
      hierarchii część-całość
      ----
      Jedno dziecko: NIE (lista dzieci)
      Rekurencja: TAK
      ----
      Użyj gdy: drzewo o dowolnej
      głębokości, ta sama operacja
      na liściu i gałęzi
    end note
}

rectangle "Dekorator" {
    note as D
      Cel: rozszerzanie zachowania
      jednego obiektu
      ----
      Jedno dziecko: TAK (wrappee)
      Rekurencja: NIE
      ----
      Użyj gdy: chcesz owijać obiekt
      nowymi warstwami zachowania
      (kompresja, logowanie, cache)
    end note
}

rectangle "Visitor" {
    note as V
      Cel: nowe operacje na
      stabilnej strukturze
      ----
      Łączy się z: Composite
      Operacja: zewnętrzna klasa
      ----
      Użyj gdy: struktura stabilna,
      często nowe operacje
      (eksport, analiza, walidacja)
    end note
}

rectangle "Prosta lista + serwis" {
    note as F
      Cel: plaska kolekcja,
      stała głębokością
      ----
      Hierarchia: 1-2 poziomy max
      Interfejs: inny per poziom
      ----
      Użyj gdy: brak potrzeby
      rekurencji ani jednolitego API
      (lista zamówień, pozycje faktury)
    end note
}

C -[hidden]- D
D -[hidden]- V
V -[hidden]- F

@enduml

